// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Admin {
  admin_id Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model User {
  user_id        Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  password       String
  role           String
  email_verified Boolean   @default(false)
  profile_image  String?
  location       String?
  created_at     DateTime  @default(now())

  tickets          Ticket[]
  favorites        FavoriteSite[]
  otpVerifications UserOTP[]
  notifications    Notification[]
  reviews          Review[]
  storyPayments    StoryPayment[]
  sitePayments     SitePayment[]
}

model UserOTP {
  otp_id     Int      @id @default(autoincrement())
  user_id    Int
  otp_code   String
  created_at DateTime @default(now())
  expires_at DateTime
  is_verified Boolean  @default(false)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model HeritageSite {
  site_id         Int      @id @default(autoincrement())
  name            String
  description     String
  photo_url       String
  gps_coordinates String
  image_path      String?

  stories    Story[]
  routes     MapRoute[]
  favorites  FavoriteSite[]
  payments   SitePayment[]
  images     HeritageSiteImage[]
}

model HeritageSiteImage {
  image_id   Int          @id @default(autoincrement())
  site_id    Int
  image_path String
  site       HeritageSite @relation(fields: [site_id], references: [site_id], onDelete: Cascade)
}

model Museum {
  museum_id       Int      @id @default(autoincrement())
  name            String
  description     String
  opening_hours   String
  gps_coordinates String
  image_path      String?

  tickets Ticket[]
  reviews Review[]
  images  MuseumImage[]
}

model MuseumImage {
  image_id   Int    @id @default(autoincrement())
  museum_id  Int
  image_path String
  museum     Museum @relation(fields: [museum_id], references: [museum_id], onDelete: Cascade)
}

model Story {
  story_id            Int    @id @default(autoincrement())
  site_id             Int
  title               String
  content             String
  god_or_goddess_name  String
  media_path            String

  site HeritageSite @relation(fields: [site_id], references: [site_id], onDelete: Cascade)
  payments StoryPayment[]
}

model MapRoute {
  route_id        Int    @id @default(autoincrement())
  site_id         Int
  start_location  String
  end_location    String
  distance        String
  estimated_time  String

  site HeritageSite @relation(fields: [site_id], references: [site_id], onDelete: Cascade)
}

model Ticket {
  ticket_id      Int      @id @default(autoincrement())
  user_id        Int
  museum_id      Int
  purchase_date  DateTime @default(now())
  ticket_pdf     String?
  price          Float
  payment_status String
  pidx           String?  @unique
  visit_date     DateTime?
  quantity       Int      @default(1)
  qr_code        String?  @unique
  status         String   @default("active") // "active", "checked_in"

  user    User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  museum Museum @relation(fields: [museum_id], references: [museum_id])

  payments Payment[]
}

model Payment {
  payment_id     Int      @id @default(autoincrement())
  ticket_id      Int
  payment_method String
  amount         Float
  payment_date   DateTime

  ticket Ticket @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)
}

model StoryPayment {
  payment_id     Int      @id @default(autoincrement())
  user_id        Int
  story_id       Int
  amount         Float
  payment_method String
  pidx           String?  @unique
  transaction_uuid String? @unique
  status         String   @default("pending") // "pending", "completed"
  created_at     DateTime @default(now())

  user    User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  story   Story  @relation(fields: [story_id], references: [story_id], onDelete: Cascade)
}

model SitePayment {
  payment_id     Int      @id @default(autoincrement())
  user_id        Int
  site_id        Int
  amount         Float
  payment_method String
  pidx           String?  @unique
  transaction_uuid String? @unique
  status         String   @default("pending") // "pending", "completed"
  created_at     DateTime @default(now())

  user    User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  site    HeritageSite @relation(fields: [site_id], references: [site_id], onDelete: Cascade)
}

model FavoriteSite {
  fav_id     Int      @id @default(autoincrement())
  user_id    Int
  site_id    Int
  added_date DateTime @default(now())

  user User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  site HeritageSite  @relation(fields: [site_id], references: [site_id], onDelete: Cascade)

  @@unique([user_id, site_id])
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  type            String   // "ticket_purchased", "payment_status", "site_update", "story_added", "route_added"
  title           String
  message         String
  is_read         Boolean  @default(false)
  related_id      Int?     // Reference to museum_id, site_id, etc.
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Review {
  review_id   Int      @id @default(autoincrement())
  user_id     Int
  museum_id   Int
  rating      Int      // 1-5 stars
  thoughts    String   @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  museum Museum @relation(fields: [museum_id], references: [museum_id], onDelete: Cascade)

  @@unique([user_id, museum_id])
}
